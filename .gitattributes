# Pollora harness (QA-06): development files stay out of the archive Composer downloads
/.gitattributes export-ignore
/.claude export-ignore
/.harness.json export-ignore
/AGENTS.md export-ignore
/api-surface.json export-ignore
/composer-dependency-analyser.php export-ignore
/rector.php export-ignore
/.github export-ignore
/.gitignore export-ignore
/phpstan.neon export-ignore
/tests export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/renovate.json export-ignore
/phpunit.integration.xml export-ignore
