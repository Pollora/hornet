{
    "name": "pollora/hornet",
    "description": "Security for WordPress: audit the configuration, harden, scan and alert. Works on classic WordPress, Bedrock and Pollora.",
    "keywords": [
        "pollora",
        "wordpress",
        "security",
        "hardening",
        "audit",
        "laravel",
        "bedrock"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Gorzalka",
            "email": "olivier@amphibee.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-tokenizer": "*",
        "pollora/abilities": "^1.0"
    },
    "require-dev": {
        "antecedent/patchwork": "^2.2",
        "brain/monkey": "^2.7",
        "illuminate/support": "^13.0",
        "laravel/pint": "^1.22.1",
        "pestphp/pest": "^3.8.2",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.1.16",
        "pollora/harness": "^0.1.40",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "suggest": {
        "illuminate/support": "Loads the package by itself inside a Pollora (Laravel) project, through the service provider.",
        "wp-cli/wp-cli": "Runs `wp hornet status` on a classic WordPress or Bedrock site.",
        "pollora/framework": "Adds the security audit to `pollora:doctor` when the package runs inside a Pollora project."
    },
    "autoload": {
        "psr-4": {
            "Pollora\\Hornet\\": "src/"
        },
        "files": [
            "src/Infrastructure/WpCli/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\Hornet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pollora\\Hornet\\Infrastructure\\Pollora\\HornetServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:unit": "pest",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast",
        "test:integration": "pest -c phpunit.integration.xml --test-directory=tests/Integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
