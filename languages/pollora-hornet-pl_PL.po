msgid "name and version of each plugin and theme go to www.wpvulnerability.net"
msgstr "nazwa i wersja każdej wtyczki i motywu są wysyłane do www.wpvulnerability.net"

msgid "Security journal"
msgstr "Dziennik bezpieczeństwa"

msgid "kept %d day"
