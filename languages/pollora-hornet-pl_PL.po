msgstr "Skanowanie już trwa."

msgid "You are not allowed to see this page."
msgstr "Nie masz uprawnień do wyświetlenia tej strony."

msgid "This screen needs scripts that this version of WordPress does not have (%s). Use `wp hornet status` and `wp hornet scan`: they give the same information."
msgstr "Ten ekran wymaga skryptów, których nie ma w tej wersji WordPressa (%s). Użyj `wp hornet status` i `wp hornet scan`: podają te same informacje."

msgid "This screen needs JavaScript. The same information is given by `wp hornet status` and `wp hornet scan`."
msgstr "Ten ekran wymaga JavaScript. Te same informacje podają `wp hornet status` i `wp hornet scan`."

msgid "Security"
msgstr "Bezpieczeństwo"

msgid "There is no such channel."
msgstr "Nie ma takiego kanału."

