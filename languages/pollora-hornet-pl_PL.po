msgstr "uruchamia polecenie (odwrotne apostrofy)"

msgid "preg_replace with the /e modifier"
msgstr "preg_replace z modyfikatorem /e"

msgid "decodes hidden data (%s)"
msgstr "dekoduje ukryte dane (%s)"

msgid "a very long string with no space in it"
msgstr "bardzo długi ciąg bez spacji"

