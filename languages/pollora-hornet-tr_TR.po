msgstr "mod %s"

msgid "chmod 640 wp-config.php (or 400)."
msgstr "chmod 640 wp-config.php (veya 400)."

msgid "wp-config.php can be read by any account on the server."
msgstr "wp-config.php, sunucudaki herhangi bir hesap tarafından okunabiliyor."

msgid "chmod 640 wp-config.php (the WordPress hardening guide advises 400 or 440)."
msgstr "chmod 640 wp-config.php (WordPress güvenlik sıkılaştırma kılavuzu 400 veya 440 önerir)."

