msgstr "WP_DEBUG değerini false yapın veya define('WP_DEBUG_DISPLAY', false) ekleyin."

msgid "WP_DEBUG is on in production."
msgstr "Canlı ortamda WP_DEBUG açık."

msgid "Define('WP_DEBUG', false) in production."
msgstr "Define('WP_DEBUG', false) canlı ortamda kullanılmalı."

msgid "WP_DEBUG_LOG writes wp-content/debug.log, a public URL unless the server blocks it."
msgstr "WP_DEBUG_LOG, wp-content/debug.log dosyasına yazar; sunucu engellemedikçe bu herkese açık bir URL'dir."

msgid "Set WP_DEBUG_LOG to a path outside the web root, or to false."
msgstr "WP_DEBUG_LOG değerini web kök dizini dışında bir yola veya false olarak ayarlayın."

msgid "Debug mode is off."
msgstr "Hata ayıklama modu kapalı."

msgid "Theme and plugin editor"
msgstr "Tema ve eklenti düzenleyicisi"

